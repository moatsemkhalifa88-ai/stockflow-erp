# Copy to .env.local and fill in. Never commit .env.local.
#
# Local Supabase (npx supabase start) prints these values; for a hosted project
# find them in Project Settings -> API Keys.

# Public (sent to the browser)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable key (sb_publishable_...) or the legacy anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret - used ONLY by `npm run seed:users` to create demo accounts.
# Secret key (sb_secret_...) or the legacy service_role key. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: password for the demo accounts (default: StockFlow!2026)
DEMO_USER_PASSWORD=

# Server-only secret - used ONLY by `npm run test:live` (concurrency test against a real database).
# Supabase dashboard -> Connect -> Connection string -> URI -> Method: "Session pooler".
# Percent-encode special characters in the password (e.g. @ -> %40, # -> %23).
DATABASE_URL=
# Optional: path to Supabase's CA certificate (Project Settings -> Database -> SSL) to verify TLS.
DATABASE_CA_CERT=
